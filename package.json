{
  "name": "@bastani/atomic-acp",
  "version": "0.0.13",
  "description": "ACP adapter for Atomic coding agent",
  "license": "MIT",
  "author": "Bastani, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bastani-inc/atomic-acp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic-acp/issues"
  },
  "homepage": "https://github.com/bastani-inc/atomic-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "atomic-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atomic-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:e2e:atomic": "node scripts/smoke-e2e-atomic.mjs",
    "smoke:mcp": "node scripts/smoke-mcp-servers.mjs",
    "smoke:workflow-wait": "node scripts/smoke-workflow-wait.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.2",
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bastani/atomic": "0.9.50",
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@bastani/atomic": ">=0.9.39"
  }
}
