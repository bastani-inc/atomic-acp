{
  "name": "@bastani/atomic-acp",
  "version": "0.0.16",
  "description": "ACP adapter for Atomic coding agent",
  "license": "MIT",
  "author": "Bastani, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bastani-inc/atomic-acp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic-acp/issues"
  },
  "homepage": "https://github.com/bastani-inc/atomic-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "atomic-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atomic-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:e2e:atomic": "node scripts/smoke-e2e-atomic.mjs",
    "smoke:mcp": "node scripts/smoke-mcp-servers.mjs",
    "smoke:workflow-wait": "node scripts/smoke-workflow-wait.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.2.0",
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bastani/atomic": "0.9.76",
    "@biomejs/biome": "2.6.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.12.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@bastani/atomic": ">=0.9.39"
  }
}
